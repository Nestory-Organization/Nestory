# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB (Playwright defaults match this):
#   MONGO_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas (get string from Atlas → Connect → Drivers; URL-encode special chars in password):
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/
# The app always uses database name "nestory" (see config/db.js), even if the URI has no path.
MONGO_URI=mongodb://127.0.0.1:27017

# JWT Configuration (use a long random string in production)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE=30d

# CORS Configuration — origin of your frontend (Vite default is often 5173)
CLIENT_URL=http://localhost:5173
